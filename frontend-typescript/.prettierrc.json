{
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "proseWrap": "always",
    "arrowParens": "always",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "plugins": ["prettier-plugin-tailwindcss"]
}
