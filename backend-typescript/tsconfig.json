{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true,
        "allowUnreachableCode": false,
        "lib": ["ESNext"],
        "types": ["node"],
        "noEmit": true,
        "jsx": "react-jsx"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "drizzle.config.ts",
        "vitest.integration.config.ts",
        "vitest.unit.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
