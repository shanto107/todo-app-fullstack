{
    "name": "backend-typescript",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "typecheck": "tsc -p tsconfig.json --watch",
        "db:seed": "NODE_ENV=development tsx src/db/scripts/seed.ts",
        "db:seed:clear": "NODE_ENV=development tsx src/db/scripts/clear-seed.ts",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:unit": "vitest run --config vitest.unit.config.ts",
        "test": "npm run test:unit && npm run test:integration",
        "test:coverage": "npm run test:unit -- --coverage && npm run test:integration -- --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.6",
        "drizzle-orm": "^0.45.2",
        "express": "^5.2.1",
        "helmet": "^8.1.0",
        "postgres": "^3.4.9",
        "sanitize-html": "^2.17.4",
        "uuid": "^14.0.0",
        "uuidv7": "^1.2.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testcontainers/postgresql": "^11.14.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.6.2",
        "@types/sanitize-html": "^2.16.1",
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.1.6",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "supertest": "^7.2.2",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^4.1.6"
    }
}
